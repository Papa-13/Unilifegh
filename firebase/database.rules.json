{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^(lobby|campus-(c[0-9]{1,3}|u[a-z0-9]{6}))$/)",
        "slow": {
          "$peer": {
            ".write": "auth != null && (newData.exists() ? newData.child('by').val() === auth.uid && (!data.exists() || data.child('by').val() === auth.uid) : data.child('by').val() === auth.uid)"
          }
        },
        "fast": {
          "$peer": {
            ".write": "auth != null && (newData.exists() ? newData.child('by').val() === auth.uid && (!data.exists() || data.child('by').val() === auth.uid) : data.child('by').val() === auth.uid)",
            ".validate": "newData.child('x').isNumber() && newData.child('y').isNumber()"
          }
        },
        "f": {
          "$cell": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.child('x').isNumber() && newData.child('y').isNumber() && $cell.matches(/^(-?[0-9]{1,3}_-?[0-9]{1,3}|i[A-Za-z0-9_-]{1,40})$/)"
            }
          }
        }
      }
    },
    "groups": {
      "$g": {
        ".read": "auth != null",
        "msgs": {
          "$m": {
            ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid",
            ".validate": "newData.hasChildren(['by','nm','tx','at']) && newData.child('tx').isString() && newData.child('tx').val().length <= 240 && newData.child('nm').isString() && newData.child('nm').val().length <= 16 && newData.child('at').isNumber()"
          }
        }
      }
    },
    "feed": {
      "$c": {
        ".read": "auth != null",
        "posts": {
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid",
            ".validate": "newData.hasChildren(['by','nm','cap','at']) && newData.child('cap').isString() && newData.child('cap').val().length <= 120 && newData.child('nm').val().length <= 16"
          }
        },
        "img": {
          "$id": {
            ".write": "auth != null && !data.exists() && root.child('feed').child($c).child('posts').child($id).child('by').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length < 70000 && newData.val().beginsWith('data:image/jpeg;base64,')"
          }
        },
        "likes": {
          "$id": {
            "$uid": {
              ".write": "auth != null && $uid === auth.uid",
              ".validate": "newData.isBoolean()"
            }
          }
        }
      }
    },
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.hasChildren(['t'])"
      }
    }
  }
}