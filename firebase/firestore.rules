rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Who lives on which campus (used for the 35/50 counts and real roommates)
    match /members/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['cp', 'nm', 'room', 'rn', 'at', 'cn'])
        && (!('cn' in request.resource.data) || (request.resource.data.cn is string && request.resource.data.cn.size() <= 24))
        && request.resource.data.cp is string && request.resource.data.cp.size() <= 8
        && request.resource.data.nm is string && request.resource.data.nm.size() <= 16;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Private messages: one document per sender -> recipient. Only those two can read it,
    // and only the sender can write it.
    match /dm/{id} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.from == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.ms is list && request.resource.data.ms.size() <= 40;
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // Gems: only the game's server (api/gems.js) changes them. You can read your own.
    match /wallets/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // 🚩 Reports: players can send one; only the owner reads them (in the Firebase console).
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by', 'about', 'nm', 'reason', 'note', 'msgs', 'campus', 'at'])
        && request.resource.data.reason in ['harass', 'sexual', 'hate', 'scam', 'spam', 'other']
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.msgs is list && request.resource.data.msgs.size() <= 10;
      allow read, update, delete: if false;
    }

    // Each player's saved student. Nobody else can read it.
    match /data/users/{uid}/{doc=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
